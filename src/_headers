/* Netlify _headers file to set caching and security headers */
/* Serve static assets with long cache TTL and immutable for generated images */
/assets/images/generated/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=31536000
/assets/js/*
  Cache-Control: public, max-age=31536000
/assets/images/*
  Cache-Control: public, max-age=31536000

/* HTML: short TTL so new deployments show quickly */
/* root HTML and other pages */
/* Setting it on all HTML files via pattern */
/*.html
  Cache-Control: public, max-age=0, must-revalidate

