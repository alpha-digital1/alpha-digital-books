{% include "seo.njk" %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">

{# Inline critical CSS for hero/header to reduce render-blocking and improve LCP #}
<style>
  /* Critical CSS - keep minimal and focused on the above-the-fold hero/header */
  :root{--primary:#0B5F8A;--accent:#D07A2B;--muted:#6B7280;--bg:#FBFDFF}
  html,body{background:var(--bg);margin:0;padding:0;color:#0f1724;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;}
  .container{max-width:1100px;margin:0 auto;padding:1rem}
  .header-inner{display:flex;align-items:center;justify-content:space-between}
  .brand{display:flex;align-items:center;gap:.6rem;text-decoration:none;color:inherit}
  .site-nav{display:flex;gap:1rem}
  .hero{padding:2rem 0}
  .hero-inner{display:flex;gap:1.5rem;align-items:center}
  .hero-copy h1{font-family:'Playfair Display',serif;font-size:1.8rem;margin:.2rem 0}
  .btn{display:inline-block;padding:.55rem .85rem;border-radius:8px;text-decoration:none}
  .btn.primary{background:var(--primary);color:#fff;border:0}
  .logo{width:48px;height:48px}
  @media(max-width:900px){.hero-inner{flex-direction:column}.site-nav{display:none}}
</style>

{# Preload the hero image and defer the main stylesheet with onload swap so it doesn't block rendering #}
<link rel="preload" href="/assets/images/hero-books.svg" as="image">
<link rel="preload" href="/assets/css/main.css" as="style" onload="this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="/assets/css/main.css"></noscript>

{# Also include the non-blocking search CSS preload for when needed #}
<link rel="preload" href="/assets/css/search.css" as="style">

</head>
<body>
  {% include "header.njk" %}

  <a class="skip-link" href="#main">Skip to main content</a>

  <main id="main" class="page-wrap">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  {# Include search overlay & initializer so search is available site-wide #}
  {% include "search-init.njk" %}

  {# Defer non-critical scripts where possible; keep search lazy-loading behavior as-is #}
</body>
</html>
