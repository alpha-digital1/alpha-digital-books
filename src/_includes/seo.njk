{%- set pageTitle = title or site.title -%}
<title>{{ pageTitle | safe }}</title>
<meta name="description" content="{{ description | default(site.description) | safe }}">
<link rel="canonical" href="{{ site.url | trimRight('/') }}{{ page.url }}">

<!-- Open Graph -->
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ pageTitle | safe }}">
<meta property="og:description" content="{{ description | default(site.description) | safe }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url | trimRight('/') }}{{ page.url }}">
{% if og_image %}
  <meta property="og:image" content="{{ og_image }}">
{% endif %}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle | safe }}">
<meta name="twitter:description" content="{{ description | default(site.description) | safe }}">

<!-- Schema fallback: we output more specific JSON-LD in templates when needed -->
