<article class="book-card">
  <a href="/books/{{ book.slug }}/">
    {% set imgPath = book.cover_image %}
    {% if imageManifest and imageManifest[imgPath] %}
      {% set m = imageManifest[imgPath] %}
      <picture>
        {% if m.avif_srcset %}
          <source type="image/avif" srcset="{{ m.avif_srcset }}" sizes="(max-width:600px) 100vw, 320px">
        {% endif %}
        {% if m.webp_srcset %}
          <source type="image/webp" srcset="{{ m.webp_srcset }}" sizes="(max-width:600px) 100vw, 320px">
        {% endif %}
        <img src="{{ m.fallback }}" srcset="{{ m.jpg_srcset }}" alt="Cover of {{ book.title }}" loading="lazy" width="300" height="450">
      </picture>
    {% else %}
      <img src="{{ book.cover_image }}" alt="Cover of {{ book.title }}" loading="lazy" width="300" height="450">
    {% endif %}
  </a>
  <div class="card-body">
    <h3><a href="/books/{{ book.slug }}/">{{ book.title }}</a></h3>
    <p class="muted">{{ book.authors | join(", ") }}</p>
    <p class="card-meta">{{ book.short_description }}</p>
    <p class="card-ctas"><a class="btn" href="/books/{{ book.slug }}/">View</a> <a class="btn amazon" href="{{ book.amazon_url | addAffiliate }}" target="_blank" rel="noopener noreferrer">Buy on Amazon</a></p>
  </div>
</article>
